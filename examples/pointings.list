ears 203.122042 -9.517750 2456293.5 0.9 568 13AE.eff
ears 204.122042 -9.517750 2456293.5 0.9 568 13AE.eff
# Polygon: n, centre RA Dec, then n lines of "dx dy" offsets in degrees.
poly 4 210.0 -10.0 2456293.5 1.0 568 poly.eff
-0.1 -0.1
